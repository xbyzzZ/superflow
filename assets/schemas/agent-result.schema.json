{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superflow.local/schemas/agent-result.schema.json",
  "title": "Superflow Agent Result",
  "description": "Strict result contract returned by each project-level specialist Agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "role",
    "taskId",
    "status",
    "summary",
    "filesChanged",
    "commandsRun",
    "verification",
    "findings",
    "evidence",
    "workflowUpdateRequest",
    "concerns"
  ],
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "architect",
        "ui-designer",
        "frontend-developer",
        "backend-developer",
        "tester",
        "code-reviewer"
      ]
    },
    "taskId": {
      "type": "string",
      "minLength": 1
    },
    "dispatchId": {
      "type": "string",
      "pattern": "^[a-f0-9]{16}$",
      "description": "The immutable dispatch identifier supplied by the main agent."
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "partial",
        "failed",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "filesChanged": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
      },
      "uniqueItems": true
    },
    "commandsRun": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/commandRun"
      }
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "memoryWriteRequests": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/memoryWriteRequest"
      }
    },
    "memoryRecall": {
      "$ref": "#/$defs/memoryRecall"
    },
    "workflowUpdateRequest": {
      "$ref": "#/$defs/workflowUpdateRequest"
    },
    "concerns": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "candidateSha": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "Tester and code reviewer must provide the candidate commit SHA frozen by the main agent."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {"enum": ["tester", "code-reviewer"]}
        },
        "required": ["role"]
      },
      "then": {
        "required": ["candidateSha"],
        "properties": {
          "candidateSha": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{7,64}$"
          },
          "verification": {
            "properties": {
              "checks": {"minItems": 1}
            }
          },
          "evidence": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"role": {"const": "tester"}},
        "required": ["role"]
      },
      "then": {
        "properties": {
          "commandsRun": {"minItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "checkStatus": {
      "type": "string",
      "enum": [
        "passed",
        "failed",
        "partial",
        "not-run"
      ]
    },
    "memoryRecall": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "available",
        "selected"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["success", "failure"]
        },
        "available": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "unknown",
        "not-applicable"
      ]
    },
    "commandRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "status",
        "exitCode",
        "summary"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/checkStatus"
        },
        "exitCode": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "details"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/checkStatus"
        },
        "details": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verdicts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec",
        "correctness",
        "consistency"
      ],
      "properties": {
        "spec": {
          "$ref": "#/$defs/verdict"
        },
        "correctness": {
          "$ref": "#/$defs/verdict"
        },
        "consistency": {
          "$ref": "#/$defs/verdict"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "checks",
        "verdicts"
      ],
      "properties": {
        "status": {
          "$ref": "#/$defs/checkStatus"
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "verdicts": {
          "$ref": "#/$defs/verdicts"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "category",
        "title",
        "detail",
        "file",
        "line"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "blocker",
            "critical",
            "high",
            "medium",
            "low",
            "info"
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "spec",
            "correctness",
            "consistency",
            "security",
            "performance",
            "testing",
            "ux",
            "other"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "line": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "status",
        "reference",
        "detail"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "file",
            "command",
            "browser",
            "ui-prototype",
            "penpot",
            "codegraph",
            "log",
            "requirement",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["success", "failure"]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "collectorRole": {
          "type": "string",
          "enum": [
            "product-manager",
            "architect",
            "ui-designer",
            "frontend-developer",
            "backend-developer",
            "tester",
            "code-reviewer"
          ]
        },
        "collectorTaskId": {
          "type": "string",
          "minLength": 1
        },
        "collectorSession": {
          "type": "string",
          "minLength": 1
        },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "adjudicatedBy": {
          "type": "string",
          "enum": [
            "architect",
            "ui-designer",
            "frontend-developer",
            "backend-developer",
            "tester",
            "code-reviewer"
          ]
        }
      }
    },
    "memoryWriteRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "summary",
        "detail",
        "tags",
        "importance",
        "evidenceRefs",
        "futureUse",
        "supersedes"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "constraint",
            "decision",
            "verified-pattern",
            "pitfall",
            "tool-fact"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "importance": {
          "type": "string",
          "enum": ["normal", "high"]
        },
        "evidenceRefs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "futureUse": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "supersedes": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-f0-9]{16}$"
          }
        }
      }
    },
    "workflowUpdateRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "targetId",
        "reason"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "none",
            "update-task",
            "update-gate",
            "request-repair",
            "block-run",
            "complete-task"
          ]
        },
        "targetId": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
