{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://superflow.local/schemas/state.schema.json",
  "title": "Superflow Run State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "run_id",
    "status",
    "tool_config",
    "active_task_id",
    "pending_repair",
    "plan",
    "candidate_sha",
    "gates",
    "repair_rounds",
    "risks",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "revision": {"type": "integer", "minimum": 1},
    "run_id": {
      "type": "string",
      "pattern": "^sf-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{8}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "initialized",
        "preflight",
        "discovery",
        "requirements_ready",
        "architecting",
        "designing",
        "planned",
        "implementing",
        "verifying",
        "reviewing",
        "fixing",
        "ready",
        "risk_accepted",
        "blocked",
        "cancelled",
        "finished"
      ]
    },
    "tool_config": {"$ref": "#/$defs/toolConfig"},
    "user_documents": {"$ref": "#/$defs/userDocuments"},
    "requirements": {
      "oneOf": [
        {"$ref": "#/$defs/requirementsMetadata"},
        {"type": "null"}
      ]
    },
    "profile": {
      "type": "string",
      "enum": ["lite", "standard", "strict"]
    },
    "profile_selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "minimum",
        "requested",
        "upgraded",
        "reasons",
        "policy"
      ],
      "properties": {
        "profile": {"type": "string", "enum": ["lite", "standard", "strict"]},
        "minimum": {"type": "string", "enum": ["lite", "standard", "strict"]},
        "requested": {
          "type": "string",
          "enum": ["auto", "lite", "standard", "strict"]
        },
        "upgraded": {"type": "boolean"},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "qualityAgents",
            "independentGates",
            "memoryLimit",
            "memoryMaxBytes",
            "resultDetail",
            "parentConversation"
          ],
          "properties": {
            "qualityAgents": {"type": "integer", "minimum": 1, "maximum": 2},
            "independentGates": {"type": "boolean"},
            "memoryLimit": {"type": "integer", "minimum": 1, "maximum": 10},
            "memoryMaxBytes": {"type": "integer", "minimum": 1, "maximum": 8192},
            "resultDetail": {
              "type": "string",
              "enum": ["compact", "standard", "full"]
            },
            "parentConversation": {"const": false}
          }
        }
      }
    },
    "active_task_id": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "null"}
      ]
    },
    "pending_repair": {
      "oneOf": [
        {"$ref": "#/$defs/pendingRepair"},
        {"type": "null"}
      ]
    },
    "plan": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "candidate_sha": {
      "oneOf": [
        {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        {"type": "null"}
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "test": {"$ref": "#/$defs/gate"},
        "review": {"$ref": "#/$defs/gate"}
      }
    },
    "repair_rounds": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 3
      }
    },
    "risks": {
      "type": "array",
      "items": {"$ref": "#/$defs/risk"}
    },
    "dispatches": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/dispatch"}
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "userDocuments": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "requirements_path", "process_log_path"],
      "properties": {
        "language": {"type": "string", "enum": ["en", "zh-CN"]},
        "requirements_path": {"const": "requirements.md"},
        "process_log_path": {"const": "process-log.md"}
      }
    },
    "requirementsMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "recorded_at", "title"],
      "properties": {
        "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "recorded_at": {"type": "string", "format": "date-time"},
        "title": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "toolSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "details"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "details": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "toolConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "browser", "ui_prototype"],
      "properties": {
        "schema_version": {"const": 1},
        "browser": {"$ref": "#/$defs/toolSelection"},
        "ui_prototype": {"$ref": "#/$defs/toolSelection"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "done", "blocked"]
        },
        "role": {
          "type": "string",
          "enum": [
            "product-manager",
            "architect",
            "ui-designer",
            "frontend-developer",
            "backend-developer",
            "tester",
            "code-reviewer"
          ]
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "authorizedPaths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "acceptanceCriteria": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "verificationCommands": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "observableResults": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "task_id", "result", "sha", "evidence", "valid", "recorded_at"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
        "task_id": {"type": "string", "minLength": 1},
        "result": {"type": "string", "enum": ["PASS", "FAIL"]},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "evidence": {},
        "valid": {"type": "boolean"},
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "gate_id", "sha", "accepted_by", "reason", "accepted_at"],
      "properties": {
        "gate": {"type": "string", "enum": ["test", "review"]},
        "gate_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
        "sha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "accepted_by": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "accepted_at": {"type": "string", "format": "date-time"}
      }
    },
    "dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatch_id",
        "task_id",
        "role",
        "session_id",
        "status",
        "worktree",
        "before_digest",
        "brief_digest",
        "started_at",
        "completed_at",
        "attempt_id"
      ],
      "properties": {
        "dispatch_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
        "task_id": {"type": "string", "minLength": 1},
        "role": {
          "type": "string",
          "enum": [
            "architect",
            "ui-designer",
            "frontend-developer",
            "backend-developer",
            "tester",
            "code-reviewer"
          ]
        },
        "session_id": {"type": "string", "minLength": 1},
        "status": {
          "type": "string",
          "enum": ["waiting", "accepted", "rejected", "blocked"]
        },
        "worktree": {"type": "string", "minLength": 1},
        "before_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "brief_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "memory_capability_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "browser_evidence": {
          "$ref": "#/$defs/browserEvidence"
        },
        "execution_profile": {
          "type": "string",
          "enum": ["lite", "standard", "strict"]
        },
        "context_mode": {"const": "minimal"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "attempt_id": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        }
      }
    },
    "browserEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "collector_role",
        "collector_task_id",
        "collector_session",
        "artifact_path",
        "artifact_sha256"
      ],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "collector_role": {"const": "product-manager"},
        "collector_task_id": {"type": "string", "minLength": 1},
        "collector_session": {"type": "string", "minLength": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "pendingRepair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "gate", "gate_id", "sha"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "gate": {"type": "string", "enum": ["test", "review"]},
        "gate_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
        "sha": {"type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"}
      }
    }
  }
}
